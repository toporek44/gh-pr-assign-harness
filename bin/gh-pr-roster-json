#!/usr/bin/env bash
set -euo pipefail
CONFIG="${GH_PR_ASSIGNEES_CONFIG:-$HOME/.config/gh/pr-default-assignees.json}"
if [[ ! -f "$CONFIG" ]] || ! command -v jq >/dev/null 2>&1; then
  echo '{"defaults":[],"ask_message":"Who should be assigned to this PR?","options":[]}'
  exit 0
fi
jq '
  .default_assignees as $def |
  (.teammates // []) as $team |
  .agent_ask_message as $msg |
  (
    [ $def[] as $login |
      ( $team[] | select(.login == $login) ) // {login: $login, name: $login}
      | . + {recommended: true}
    ] +
    ([ $team[] | select(.login as $l | ($def | index($l)) | not) ] | sort_by(.name))
  ) as $ordered |
  (
    [ $def[] as $login |
      (($team[] | select(.login == $login) | .name) // $login)
    ] | join(", ")
  ) as $def_label |
  {
    ask_message: ($msg // "Who should be assigned to this PR?"),
    defaults: $def,
    options: (
      [{
        id: "__use_defaults__",
        label: ("Use defaults only: " + $def_label + " (Recommended — tap this alone to skip picking individuals)")
      }] +
      [ $ordered[] |
        {
          id: .login,
          label: ((.name // .login) + " (" + .login + ")" + (if .recommended then " (Recommended — default)" else "" end))
        }
      ]
    )
  }
' "$CONFIG"