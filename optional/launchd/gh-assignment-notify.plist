<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.gh-pr-assign-harness.notify</string>
  <key>ProgramArguments</key>
  <array>
    <string>@INSTALL_DIR@/hooks/gh-assignment-notify.sh</string>
  </array>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>@HOME@/.cache/gh-assignment-notify/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>@HOME@/.cache/gh-assignment-notify/launchd.err</string>
</dict>
</plist>