{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "@INSTALL_DIR@/hooks/gh-pr-session-context.sh",
        "timeout": 5
      }
    ],
    "beforeShellExecution": [
      {
        "command": "@INSTALL_DIR@/hooks/gh-pr-ask-before-create.sh",
        "matcher": "gh\\s+pr\\s+create",
        "timeout": 10
      }
    ],
    "afterShellExecution": [
      {
        "command": "@INSTALL_DIR@/hooks/gh-pr-assign-after-create.sh",
        "matcher": "gh\\s+pr\\s+create",
        "timeout": 45
      }
    ]
  }
}